<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- NFC and vibration permissions -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/app_main_logo_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/app_main_logo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TEST_APPWEER2"
        tools:targetApi="31">
        <!-- Main launcher activity -->
        <activity
            android:name="com.example.test_appweer2.AdvancedCommands"
            android:exported="true"
            android:launchMode="singleTop"/>
        <activity
            android:name=".ReadActivity"
            android:exported="true"
            android:launchMode="singleTop"/>
        <activity
            android:name=".ComposeWriteActivity"
            android:exported="true"
            android:launchMode="singleTop"/>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
